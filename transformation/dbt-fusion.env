# Version de dbt Fusion installée par la CI (ci.yml) et par le pipeline (pipeline-france-travail.yml).
# dbt Fusion n'est pas un paquet Python : archive officielle, version et empreinte figées.
# Empreinte publiée par le CDN dans <archive>.sha256 :
#   https://public.cdn.getdbt.com/fs/cli/fs-v<version>-x86_64-unknown-linux-gnu.tar.gz.sha256
# Monter la version impose de relire la surcharge macros/bigquery__snapshot_merge_sql.sql,
# qui recopie du code interne de Fusion.
DBT_VERSION=2.0.6
DBT_SHA256=64611a38348383eae86a4834611cfc786f96cdbc907fbdf93825c5560d20c197
